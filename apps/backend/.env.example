NODE_ENV=production
HOST=0.0.0.0
PORT=4000

# Production target after PostgreSQL migration.
DATABASE_URL=postgresql://fedshield:CHANGE_ME@127.0.0.1:5432/fedshield?schema=public

JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
DOCUMENT_SEAL_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
STORAGE_DIR=/opt/fedshield-storage
VERIFICATION_BASE_URL=https://example.com

ATTESTATO_TEMPLATE_PDF_PATH=assets/templates/attestato_antisanzione_template.pdf
ATTESTATO_TEMPLATE_DOCX_PATH=assets/templates/attestato_antisanzione_template_placeholders.docx
ATTESTATO_LOGO_PATH=assets/templates/attestato_template_logo.png
ATTESTATO_MIN_SCORE=75

QUOTE_SWEEP_SECONDS=60
LICENSE_ACTIVATION_CODE=CHANGE_ME
LICENSE_DURATION_DAYS=365
LICENSE_GRACE_DAYS=30

# Optional n8n integration.
N8N_AUDITBOT_WEBHOOK=
FEDSHIELD_N8N_API_KEY=
FEDSHIELD_N8N_ALLOWED_HOSTS=
