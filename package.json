{
  "name": "fedshield",
  "version": "0.1.0",
  "private": true,
  "description": "FedShield - piattaforma anti-sanzione locale-first",
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @fedshield/backend dev",
    "dev:desktop": "pnpm --filter @fedshield/desktop dev",
    "dev:tablet": "pnpm --filter @fedshield/tablet start",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "electron",
      "esbuild",
      "prisma"
    ]
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
